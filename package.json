{
  "name": "dispatcher-cli",
  "version": "0.7.1",
  "description": "Call Codex from Claude Code without leaving your session, or Claude Code from Codex CLI",
  "type": "module",
  "bin": {
    "dispatch": "./src/index.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:bin": "bun build src/index.ts --compile --outfile dist/dispatch && (codesign --sign - --force dist/dispatch 2>/dev/null || true)",
    "prepare": "husky"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "arrowParens": "always"
  }
}
