{
  "project_name": "dispatcher-cli",
  "project_type": "cli_tool",
  "scan": {
    "stack": "TypeScript on Bun >= 1.3",
    "package_manager": "bun",
    "lockfile": "bun.lock",
    "test_runner": "bun:test",
    "test_dir": "tests",
    "formatter": "prettier (config inline in package.json)",
    "linter": "none (prettier --check used as style gate)",
    "ci": "none",
    "monorepo": false,
    "existing_ai_config": "none",
    "existing_claude_settings": false,
    "commit_history": "no commits yet (fresh repo, will git init during bootstrap)",
    "prd_detected": "docs/prd.md (standard FM-ID schema, FM-001..FM-007)"
  },
  "prd_path": "docs/prd.md",
  "prd_format": "standard",
  "jira_project": null,
  "branch_strategy": {
    "policy": "one feature branch per requirement",
    "pattern": "feat/<slug>",
    "fm_pattern": "feat/<FM-ID>-<slug>",
    "examples": [
      "feat/timeout-flag",
      "feat/FM-005-env-defaults",
      "fix/codex-output-warning"
    ]
  },
  "commit_regex": "^(feat|fix|refactor|test|docs|chore|perf|build|ci|style|revert)(\\([A-Za-z0-9-]+\\))?: .+",
  "commit_pattern_description": "Conventional Commits — type(scope?): subject (e.g. 'feat(FM-002): add --timeout flag')",
  "commit_examples": [
    "feat(FM-002): support stdin prompt input",
    "fix(FM-003): handle missing claude binary with clear error",
    "refactor(adapters): extract shared BuiltCommand shape"
  ],
  "verification": {
    "typecheck": "bun run typecheck",
    "test": "bun test",
    "format_check": "bunx prettier --check .",
    "build_smoke": "bun build src/index.ts --target=bun --outdir .orchestrator/.build-smoke"
  },
  "formatter_command": "bunx prettier --write",
  "state_machine": {
    "template": "simple",
    "states": [
      "pending",
      "enriching",
      "architecting",
      "in_progress",
      "verifying",
      "done",
      "failed",
      "dependency_failed"
    ],
    "first_active_state": "architecting",
    "active_implementation_state": "in_progress",
    "transitions": [
      {
        "from": "pending",
        "to": "enriching",
        "condition": "task becomes active (dependencies met)"
      },
      {
        "from": "enriching",
        "to": "architecting",
        "condition": "awaiting_confirmation === false AND (needs_checkpoint === false OR checkpoint.status !== 'pending')"
      },
      {
        "from": "architecting",
        "to": "in_progress",
        "condition": "architecture written AND no decision has source === 'unresolved'"
      },
      {
        "from": "in_progress",
        "to": "verifying",
        "condition": "implementer reports work complete"
      },
      {
        "from": "verifying",
        "to": "done",
        "condition": "all verification checks pass; planner commits, then marks done"
      },
      {
        "from": "verifying",
        "to": "in_progress",
        "condition": "verification failed; retry with failure context"
      },
      { "from": "*", "to": "failed", "condition": "retry_count >= max_retries" }
    ]
  },
  "sub_agent_roles": {
    "enricher": { "active": true, "model": "sonnet" },
    "architect": { "active": true, "model": "sonnet" },
    "implementer": {
      "active": true,
      "model_routine": "sonnet",
      "model_complex": "opus",
      "upgrade_on_consecutive_failures": 2
    },
    "code_reviewer": {
      "active": true,
      "model": "sonnet",
      "count": 1,
      "style": "single_reviewer_merged_into_verify"
    },
    "qa_verifier": { "active": true, "model": "haiku" },
    "pm_tester": {
      "active": false,
      "model": "sonnet",
      "reason": "Simple template — acceptance handled inline by qa_verifier via cli smoke tests"
    },
    "housekeeper": { "active": true, "model": "opus" }
  },
  "models": {
    "planner": "opus",
    "enricher": "sonnet",
    "architect": "sonnet",
    "implementer_routine": "sonnet",
    "implementer_complex": "opus",
    "code_reviewer": "sonnet",
    "qa_verifier": "haiku",
    "housekeeper": "opus"
  },
  "review_score_threshold": 15,
  "scoring_weights": {
    "security": { "medium": 5, "low": 2 },
    "data_integrity": { "medium": 5, "low": 2 },
    "requirements": { "medium": 4, "low": 1 },
    "test_coverage": { "medium": 4, "low": 1 },
    "error_handling": { "medium": 4, "low": 1 },
    "convention_violations": { "medium": 3, "low": 1 },
    "code_quality": { "medium": 3, "low": 1 },
    "edge_cases": { "medium": 3, "low": 1 },
    "performance": { "medium": 3, "low": 1 },
    "maintainability": { "medium": 2, "low": 0.5 },
    "style_preferences": { "low": 0.5 },
    "nice_to_haves": { "low": 0.5 }
  },
  "custom_review_rules": [
    "CLI argument parsing must not silently swallow unknown flags — fail with clear usage hint.",
    "Subprocess spawning must always inherit stdio (no buffering) and forward SIGINT/SIGTERM.",
    "New adapters must register in src/adapters/registry.ts and have a unit test mirroring claude/codex coverage."
  ],
  "acceptance_testing": {
    "strategy": "cli",
    "base_url": null,
    "evidence": ["terminal_output", "exit_code"],
    "notes": "Simple state machine has no separate acceptance state. CLI smoke checks (e.g. `dispatch --help`, `dispatch list`, `dispatch exec -a <agent> 'hi'` with mocked or short prompt) run as part of `verifying`. Enricher still generates acceptance_steps so they are documented per task."
  },
  "max_retries": 3,
  "max_housekeeper_cycles": 3
}
