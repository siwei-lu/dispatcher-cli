{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if jq -r '.tool_input.command' | grep -qE '(^|[[:space:]/])dist/dispatch([[:space:]]|$)'; then echo 'Use the linked `dispatch` on PATH instead of `dist/dispatch` (linked at /Users/siwei.lu/.local/bin/dispatch).' >&2; exit 2; fi"
          },
          {
            "type": "command",
            "command": "node .orchestrator/hooks/pre-bash-gate.cjs"
          },
          {
            "type": "command",
            "command": "node .orchestrator/hooks/pre-commit-format.cjs"
          },
          {
            "type": "command",
            "command": "node .orchestrator/hooks/pre-done-gate.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .orchestrator/hooks/post-edit-format.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .orchestrator/hooks/session-inject.cjs"
          }
        ]
      }
    ]
  }
}
