{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .orchestrator/hooks/pre-bash-gate.cjs"
          },
          {
            "type": "command",
            "command": "node .orchestrator/hooks/pre-commit-format.cjs"
          },
          {
            "type": "command",
            "command": "node .orchestrator/hooks/pre-done-gate.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .orchestrator/hooks/post-edit-format.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .orchestrator/hooks/session-inject.cjs"
          }
        ]
      }
    ]
  }
}
